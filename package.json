{
  "name": "@aibuildinfra/proofgraph",
  "version": "1.0.0",
  "mcpName": "io.github.AI-BuildInfra/proof-graph",
  "description": "Evidence-first knowledge and entity graph MCP server for AI agents to verify claims, discover relationships, and retrieve compact evidence packets. By AI Build Infra.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "proofgraph": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "node dist/cli/index.js",
    "dashboard": "node dist/dashboard/server.js",
    "test": "node --test dist/tests/*.test.js",
    "benchmark": "node dist/cli/index.js benchmark",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist",
    "server.json",
    "smithery.yaml",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-BuildInfra/proof-graph.git"
  },
  "homepage": "https://aibuildinfra.com/proofgraph/",
  "author": {
    "name": "AI Build Infra",
    "url": "https://aibuildinfra.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AI-BuildInfra/proof-graph/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "entity-graph",
    "knowledge-graph",
    "claim-verification",
    "evidence-retrieval",
    "token-optimization",
    "provenance",
    "ai-build-infra",
    "antigravity"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
